/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notifier",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  /**
   * Smart Placement
   * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
  "placement": { "mode": "smart" },
  /**
   * Environment Variables
   * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
   * Note: Use secrets to store sensitive data.
   * https://developers.cloudflare.com/workers/configuration/secrets/
   */
  "vars": {
    "DISCORD_DEFAULT_CHANNEL": "1508481995917754418",
    "DISCORD_DEFAULT_YOUTUBE_CHANNEL": "1522051130199380068",
    // Public callback URL used for YouTube WebSub subscriptions.
    // `npm start` overrides this with `--var` (`.dev.vars` cannot, because
    // `secrets.required` only loads listed secrets).
    "SERVICE_URL": "https://notifier.grenuttag.workers.dev",
  },
  "kv_namespaces": [
    {
      "binding": "SUBSCRIPTIONS",
      "id": "e63f654438284b74afc969cbb88819e7",
    },
  ],
  "secrets": {
    "required": ["DISCORD_TOKEN", "ADMIN_TOKEN", "YOUTUBE_TOKEN"],
  },
  "triggers": {
    "crons": ["0 0 * * *"],
  },
  "queues": {
    "producers": [
      {
        "binding": "YOUTUBE_SUBSCRIBE",
        "queue": "notifier-youtube-websub",
      },
    ],
    "consumers": [
      {
        "queue": "notifier-youtube-websub",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 100,
        "retry_delay": 60,
      },
    ],
  },
}
